# wiliwili - writes build_version.h with the number of this build.
#
# Called by the update_build_version target:
#
#   cmake -DSEED=<commits> -DBASE_VERSION=<x.y.z> \
#         -DSTATE=<build dir>/build_number.txt \
#         -DHEADER=<build dir>/include/build_version.h \
#         -P scripts/update_build_number.cmake
#
# The state file remembers the last build of this build directory, so the number
# grows on every build; SEED keeps a fresh build directory from starting lower
# than the commit it was made from. Nothing is written to the source tree.

if (EXISTS "${STATE}")
    file(READ "${STATE}" previous)
    string(STRIP "${previous}" previous)
else ()
    set(previous 0)
endif ()

if (NOT previous MATCHES "^[0-9]+$")
    set(previous 0)
endif ()
if (NOT SEED MATCHES "^[0-9]+$")
    set(SEED 0)
endif ()

if (SEED GREATER previous)
    set(number ${SEED})
else ()
    set(number ${previous})
endif ()
math(EXPR number "${number} + 1")

file(WRITE "${STATE}" "${number}\n")

get_filename_component(directory "${HEADER}" DIRECTORY)
file(MAKE_DIRECTORY "${directory}")
file(WRITE "${HEADER}"
"/* Generated by scripts/update_build_number.cmake - do not edit */
#ifndef WILIWILI_BUILD_VERSION_H
#define WILIWILI_BUILD_VERSION_H

#define WILIWILI_BUILD_NUMBER ${number}
#define WILIWILI_BUILD_VERSION_TAG \"v${BASE_VERSION}(${number})\"

#endif
")

message(STATUS "Build number: v${BASE_VERSION}(${number})")
