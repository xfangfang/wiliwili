 typedef struct mpv_render_context mpv_render_context;
 
 /**
+ * MPV_RENDER_PARAM_DOVI_METADATA: the Dolby Vision metadata of the frame that
+ * mpv_render_context_render() just drew, prepacked for a std140 fragment
+ * uniform block. It follows libplacebo's Dolby Vision decoding maths:
+ *
+ *   sig = clamp(frame code / 2^bl_bit_depth, 0, 1)              (3 planes)
+ *   t   = reshape(sig) - off                                     (per comp.)
+ *   lms = PQ^-1(ycc * t)
+ *   rgb = lms * lms_matrix                                       (BT.2020)
+ *
+ * The arrays are rows of vec4 so that the struct can be uploaded to the GPU
+ * as-is. All fields are zeroed when the frame carries no RPU.
+ *
+ *   ycc[3]   YCC -> L'M'S' rows, xyz of each vec4
+ *   off      signal offset subtracted before ycc ("ycc_to_rgb_offset")
+ *   lms[3]   linear LMS -> linear BT.2020 RGB rows (lms2rgb * rgb_to_lms)
+ *   lohi[c]  { lowest pivot, highest pivot, has curve, - }
+ *   piv      the inner pivots of each component, two vec4 per component,
+ *            padded with a 1e9 sentinel
+ *   coef[i]  piece i of component i / 8: polynomial {c0, c1, c2, 0}, or MMR
+ *            { constant, index into mmr, -, order }
+ *   mmr      the MMR weights, 48 vec4 per component
+ *   meta     x: 1 when the frame carries an RPU, y/z: source width/height
+ *            (caller writable, zeroed on every render)
+ */
+typedef struct mpv_dovi_metadata {
+    float ycc[3][4];
+    float off[4];
+    float lms[3][4];
+    float lohi[3][4];
+    float piv[6][4];
+    float coef[24][4];
+    float mmr[144][4];
+    float meta[4];
+} mpv_dovi_metadata;
+
