<brls:AppletFrame
        id="video/detail/frame"
        iconInterpolation="linear"
        headerHidden="true"
        footerHidden="true">

    <brls:Box
            width="auto"
            height="auto"
            grow="1.0"
            axis="column">

        <VideoView
                id="video"
                focusable="false"
                grow="1"
                width="100%"
                height="auto"/>

    </brls:Box>

</brls:AppletFrame>
