<brls:AppletFrame
        id="video/detail/frame"
        iconInterpolation="linear"
        headerHidden="true"
        footerHidden="false">
    <brls:Box
            width="auto"
            height="auto"
            grow="1.0"
            axis="row">

        <!--页面左侧-->
        <brls:Box
                id="live_detail_left_box"
                margin="10"
                width="@style/wiliwili/player/width"
                height="auto"
                wireframe="false"
                axis="column">

            <VideoView
                    id="video"
                    focusable="true"
                    focusDown="live_detail_info_box"
                    focusRight="live_danmaku_sidebar"
                    grow="1"
                    width="@style/wiliwili/player/width"
                    height="auto"/>

            <!--直播UP主相关信息-->
            <brls:Box
                    id="live_detail_info_box"
                    wireframe="false"
                    width="100%"
                    height="100"
                    axis="column">

                <brls:Box
                        wireframe="false"
                        width="100%"
                        height="100%"
                        alignItems="flexStart"
                        justifyContent="center">
                    <UserInfoView
                            focusable="true"
                            wireframe="false"
                            marginLeft="10"
                            id="live_author"
                            focusUp="video"
                            focusRight="live_danmaku_sidebar"
                            width="100%"
                            height="80%"/>
                </brls:Box>
            </brls:Box>
        </brls:Box>

        <!--右侧弹幕侧边栏-->
        <brls:Box
                id="live_danmaku_sidebar"
                width="220"
                height="auto"
                axis="column"
                grow="1">
            
            <brls:Header
                    title="实时弹幕"
                    paddingTop="15"/>
                    
            <brls:ScrollingFrame
                    id="live_danmaku_list"
                    width="100%"
                    height="auto"
                    grow="1">
                <brls:Box
                        id="live_danmaku_container"
                        width="100%"
                        height="auto"
                        axis="column">
                    <!-- 弹幕内容将动态添加到这里 -->
                </brls:Box>
            </brls:ScrollingFrame>
        </brls:Box>
    </brls:Box>
</brls:AppletFrame> 